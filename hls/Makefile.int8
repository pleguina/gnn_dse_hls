# Makefile for Pure INT8 GraphSAGE HLS
# Compiles C simulation testbench

CXX = g++
CXXFLAGS = -std=c++11 -O2 -Wall -I.

# M_BITS configuration (20 or 24)
# M=20: 13 LSB max error, smaller multipliers
# M=24: 0 LSB error (exact match), larger multipliers
M_BITS ?= 24

CXXFLAGS += -DM_BITS=$(M_BITS)

# Source files
SRCS = graphsage_layer_int8.cpp testbench_int8.cpp
OBJS = $(SRCS:.cpp=.o)
TARGET = test_int8

.PHONY: all clean run m20 m24

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Run with M=24 (exact match)
run: $(TARGET)
	./$(TARGET)

# Build and run with M=20 (13 LSB error)
m20:
	$(MAKE) clean
	$(MAKE) M_BITS=20 all
	./$(TARGET)

# Build and run with M=24 (0 LSB error)
m24:
	$(MAKE) clean
	$(MAKE) M_BITS=24 all
	./$(TARGET)

clean:
	rm -f $(OBJS) $(TARGET)

# Show configuration
info:
	@echo "M_BITS = $(M_BITS)"
	@echo "  M=20: 20-bit scales, 13 LSB max error"
	@echo "  M=24: 24-bit scales, 0 LSB error (recommended)"
