$(BUILD_HLS_DIR)/csc_interface/solution1/syn/report/csc_omtf_interface_csynth.rpt:
	@$(ECHO) "$(YELLOW)⚠️  Synthesis report not found, running synthesis first...$(NC)"
	@$(MAKE) -f Makefile.hls hls_synth_csc

hls_cosim_csc: $(BUILD_HLS_DIR)/csc_interface/solution1/syn/report/csc_omtf_interface_csynth.rpt $(BUILD_DIR)/tb_csc_interface
	@$(ECHO) "$(GREEN)▶ Running RTL co-simulation for csc_interface...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/csc_interface/logs
	cd $(BUILD_HLS_DIR)/csc_interface && $(VITIS_HLS) -f cosim.tcl 2>&1 | tee logs/cosim.log
	@$(ECHO) "$(GREEN)✅ Co-simulation complete - check $(BUILD_HLS_DIR)/csc_interface/logs/cosim.log$(NC)"

hls_all_csc: hls_csim_csc hls_synth_csc hls_cosim_csc
	@$(ECHO) "$(GREEN)✅ Complete HLS flow finished for csc_interface$(NC)"

hls_clean_csc:
	@$(ECHO) "$(YELLOW)▶ Cleaning csc_interface HLS artifacts...$(NC)"
	rm -rf $(BUILD_HLS_DIR)/csc_interface
	@$(ECHO) "$(GREEN)✅ Cleaned$(NC)"

# -----------------------------------------------------------------------------
# (and so on for concentrator, layermem, region_filter, priority_arbiter,
# phi_extrapolation, phi_dist_processor, pdf_lookup, best_candidate, doublebuff)
#
# NOTE: in each hls_export_<module>:
#   - keep the dependency on the *_csynth.rpt
#   - REMOVE the `mkdir -p ip_packages` line
#   - keep the pattern:
#
#       cd $(BUILD_HLS_DIR)/<module> && $(VITIS_HLS) -f ip_export.tcl ...
#
#   because ip_export.tcl now knows the absolute ip_packages/ path and
#   will create it itself if needed.
#
# I'm not duplicating those blocks here because they are structurally the same
# as dt_interface and csc_interface after the edits above.
#
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# NN Interface (synthesis and export only, no testing)
# -----------------------------------------------------------------------------

hls_synth_nn_interface: hls_setup_nn_interface
