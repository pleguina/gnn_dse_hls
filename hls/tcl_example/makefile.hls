	cd $(BUILD_HLS_DIR)/nn_interface && $(VITIS_HLS) -f ip_export.tcl 2>&1 | tee logs/ip_export.log
	@$(ECHO) "$(GREEN)✅ IP export complete - check $(BUILD_HLS_DIR)/nn_interface/logs/ip_export.log$(NC)"

$(BUILD_HLS_DIR)/nn_interface/solution1/syn/report/NNInterface_csynth.rpt:
	@$(ECHO) "$(YELLOW)⚠️  Synthesis report not found, running synthesis first...$(NC)"
	@$(MAKE) -f Makefile.hls hls_synth_nn_interface

hls_clean_nn_interface:
	@$(ECHO) "$(YELLOW)▶ Cleaning nn_interface HLS artifacts...$(NC)"
	rm -rf $(BUILD_HLS_DIR)/nn_interface
	@$(ECHO) "$(GREEN)✅ Cleaned$(NC)"

