.PHONY: all help clean

# Configuration
VITIS_HLS ?= vitis_hls
PYTHON ?= python3
BUILD_DIR ?= build
BUILD_HLS_DIR ?= build_hls
TEMPLATE_DIR ?= verification/templates
TOOLS_DIR ?= verification/tools
LOG_DIR ?= logs/hls
SHELL := /bin/bash
PARALLEL_SCRIPT ?= scripts/parallel_hls.sh
PARALLEL_JOBS ?= 4

# Available modules
MODULES = dt_interface csc_interface concentrator layermem region_filter priority_arbiter phi_extrapolation phi_dist_processor pdf_lookup best_candidate pdf_lookup_best_candidate phidist_pdf_best doublebuff nn_interface regression_nn

# Colors
GREEN = \033[0;32m
YELLOW = \033[0;33m
RED = \033[0;31m
NC = \033[0m  # No Color

ECHO = /bin/echo -e

# -----------------------------------------------------------------------------
# Help
# -----------------------------------------------------------------------------

help:
	@echo "$(GREEN)OMTF Vitis HLS Verification Makefile$(NC)"
	@echo ""
	@echo "$(YELLOW)Setup:$(NC)"
	@echo "  make -f Makefile.hls hls_setup              Generate TCL scripts for all modules"
	@echo "  make -f Makefile.hls hls_setup_<module>     Generate TCL for specific module"
	@echo ""
	@echo "$(YELLOW)Per-Module Workflows:$(NC)"
	@echo "  make -f Makefile.hls hls_csim_<module>      Run C simulation"
	@echo "  make -f Makefile.hls hls_synth_<module>     Run synthesis"
	@echo "  make -f Makefile.hls hls_cosim_<module>     Run RTL co-simulation"
	@echo "  make -f Makefile.hls hls_export_<module>    Export IP package"
	@echo "  make -f Makefile.hls hls_all_<module>       Run complete flow (csim → synth → cosim)"
	@echo ""
	@echo "$(YELLOW)Batch Operations:$(NC)"
	@echo "  make -f Makefile.hls hls_csim_all           Run C simulation for all modules"
	@echo "  make -f Makefile.hls hls_synth_all          Run synthesis for all modules"
	@echo "  make -f Makefile.hls hls_cosim_all          Run co-simulation for all modules"
	@echo "  make -f Makefile.hls hls_export_all         Export IP packages for all modules"
	@echo ""
	@echo "$(YELLOW)Parallel Operations (Fast):$(NC)"
	@echo "  make -f Makefile.hls hls_parallel_synth PARALLEL_JOBS=4 MODULES=\"dt_interface csc_interface\""
	@echo "  make -f Makefile.hls hls_parallel_export PARALLEL_JOBS=2 MODULES=\"all\""
	@echo ""
	@echo "$(YELLOW)Available modules:$(NC) $(MODULES)"

# -----------------------------------------------------------------------------
# Setup - Generate TCL scripts
# -----------------------------------------------------------------------------

hls_setup:
	@$(ECHO) "$(GREEN)▶ Generating HLS TCL scripts for all modules...$(NC)"
	@$(PYTHON) $(TOOLS_DIR)/generate_hls_tcl.py all \
		--template-dir $(TEMPLATE_DIR) \
		--output-dir $(BUILD_HLS_DIR)
	@$(ECHO) "$(GREEN)✅ TCL generation complete$(NC)"

hls_setup_%:
	@$(ECHO) "$(GREEN)▶ Generating HLS TCL scripts for $*...$(NC)"
	@$(PYTHON) $(TOOLS_DIR)/generate_hls_tcl.py $* \
		--template-dir $(TEMPLATE_DIR) \
		--output-dir $(BUILD_HLS_DIR)
	@$(ECHO) "$(GREEN)✅ TCL generation complete for $*$(NC)"

# -----------------------------------------------------------------------------
# DT Interface
# -----------------------------------------------------------------------------

hls_csim_dt: hls_setup_dt_interface $(BUILD_DIR)/tb_dt_interface
	@$(ECHO) "$(GREEN)▶ Running C simulation for dt_interface...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/dt_interface/logs
	cd $(BUILD_HLS_DIR)/dt_interface && $(VITIS_HLS) -f project.tcl 2>&1 | tee logs/project.log
	cd $(BUILD_HLS_DIR)/dt_interface && $(VITIS_HLS) -f csim.tcl    2>&1 | tee logs/csim.log
	@$(ECHO) "$(GREEN)✅ C simulation complete - check $(BUILD_HLS_DIR)/dt_interface/logs/csim.log$(NC)"

hls_synth_dt: hls_setup_dt_interface
	@$(ECHO) "$(GREEN)▶ Running synthesis for dt_interface...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/dt_interface/logs
	cd $(BUILD_HLS_DIR)/dt_interface && $(VITIS_HLS) -f project.tcl 2>&1 | tee logs/project.log
	cd $(BUILD_HLS_DIR)/dt_interface && $(VITIS_HLS) -f synth.tcl    2>&1 | tee logs/synth.log
	@$(ECHO) "$(GREEN)✅ Synthesis complete - check $(BUILD_HLS_DIR)/dt_interface/logs/synth.log$(NC)"

hls_export_dt: $(BUILD_HLS_DIR)/dt_interface/solution1/syn/report/dt_omtf_interface_csynth.rpt
	@$(ECHO) "$(GREEN)▶ Exporting IP for dt_interface...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/dt_interface/logs
	cd $(BUILD_HLS_DIR)/dt_interface && $(VITIS_HLS) -f ip_export.tcl 2>&1 | tee logs/ip_export.log
	@$(ECHO) "$(GREEN)✅ IP export complete - check $(BUILD_HLS_DIR)/dt_interface/logs/ip_export.log$(NC)"

$(BUILD_HLS_DIR)/dt_interface/solution1/syn/report/dt_omtf_interface_csynth.rpt:
	@$(ECHO) "$(YELLOW)⚠️  Synthesis report not found, running synthesis first...$(NC)"
	@$(MAKE) -f Makefile.hls hls_synth_dt

hls_cosim_dt: $(BUILD_HLS_DIR)/dt_interface/solution1/syn/report/dt_omtf_interface_csynth.rpt $(BUILD_DIR)/tb_dt_interface
	@$(ECHO) "$(GREEN)▶ Running RTL co-simulation for dt_interface...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/dt_interface/logs
	cd $(BUILD_HLS_DIR)/dt_interface && $(VITIS_HLS) -f cosim.tcl 2>&1 | tee logs/cosim.log
	@$(ECHO) "$(GREEN)✅ Co-simulation complete - check $(BUILD_HLS_DIR)/dt_interface/logs/cosim.log$(NC)"

hls_all_dt: hls_csim_dt hls_synth_dt hls_cosim_dt
	@$(ECHO) "$(GREEN)✅ Complete HLS flow finished for dt_interface$(NC)"

hls_clean_dt:
	@$(ECHO) "$(YELLOW)▶ Cleaning dt_interface HLS artifacts...$(NC)"
	rm -rf $(BUILD_HLS_DIR)/dt_interface
	@$(ECHO) "$(GREEN)✅ Cleaned$(NC)"

# -----------------------------------------------------------------------------
# CSC Interface
# -----------------------------------------------------------------------------

