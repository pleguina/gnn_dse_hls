	cd $(BUILD_HLS_DIR)/pdf_lookup_best_candidate && $(VITIS_HLS) -f ip_export.tcl 2>&1 | tee logs/ip_export.log
	@$(ECHO) "$(GREEN)✅ IP export complete - check $(BUILD_HLS_DIR)/pdf_lookup_best_candidate/logs/ip_export.log$(NC)"

$(BUILD_HLS_DIR)/pdf_lookup_best_candidate/solution1/syn/report/pdf_lookup_best_candidate_csynth.rpt:
	@$(ECHO) "$(YELLOW)⚠️  Synthesis report not found, running synthesis first...$(NC)"
	@$(MAKE) -f Makefile.hls hls_synth_pdf_lookup_best_candidate

hls_cosim_pdf_lookup_best_candidate: $(BUILD_HLS_DIR)/pdf_lookup_best_candidate/solution1/syn/report/pdf_lookup_best_candidate_csynth.rpt $(BUILD_DIR)/tb_pdf_lookup_best_candidate
	@$(ECHO) "$(GREEN)▶ Running RTL co-simulation for pdf_lookup_best_candidate...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/pdf_lookup_best_candidate/logs
	cd $(BUILD_HLS_DIR)/pdf_lookup_best_candidate && $(VITIS_HLS) -f cosim.tcl 2>&1 | tee logs/cosim.log
	@$(ECHO) "$(GREEN)✅ Co-simulation complete - check $(BUILD_HLS_DIR)/pdf_lookup_best_candidate/logs/cosim.log$(NC)"

hls_all_pdf_lookup_best_candidate: hls_csim_pdf_lookup_best_candidate hls_synth_pdf_lookup_best_candidate hls_cosim_pdf_lookup_best_candidate
	@$(ECHO) "$(GREEN)✅ Complete HLS flow finished for pdf_lookup_best_candidate$(NC)"

hls_clean_pdf_lookup_best_candidate:
	@$(ECHO) "$(YELLOW)▶ Cleaning pdf_lookup_best_candidate HLS artifacts...$(NC)"
	rm -rf $(BUILD_HLS_DIR)/pdf_lookup_best_candidate
