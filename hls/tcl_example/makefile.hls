hls_synth_pdf_lookup_best_candidate: hls_setup_pdf_lookup_best_candidate
	@$(ECHO) "$(GREEN)▶ Running synthesis for pdf_lookup_best_candidate...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/pdf_lookup_best_candidate/logs
	cd $(BUILD_HLS_DIR)/pdf_lookup_best_candidate && $(VITIS_HLS) -f project.tcl 2>&1 | tee logs/project.log
