# -----------------------------------------------------------------------------
# PhiDist + PDF + Best Candidate Combined Module (synthesis and export only)
# -----------------------------------------------------------------------------

hls_synth_phidist_pdf_best: hls_setup_phidist_pdf_best
	@$(ECHO) "$(GREEN)▶ Running synthesis for phidist_pdf_best...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/phidist_pdf_best/logs
	cd $(BUILD_HLS_DIR)/phidist_pdf_best && $(VITIS_HLS) -f project.tcl 2>&1 | tee logs/project.log
	cd $(BUILD_HLS_DIR)/phidist_pdf_best && $(VITIS_HLS) -f synth.tcl    2>&1 | tee logs/synth.log
	@$(ECHO) "$(GREEN)✅ Synthesis complete - check $(BUILD_HLS_DIR)/phidist_pdf_best/logs/synth.log$(NC)"

hls_export_phidist_pdf_best: $(BUILD_HLS_DIR)/phidist_pdf_best/solution1/syn/report/phidist_pdf_best_csynth.rpt
	@$(ECHO) "$(GREEN)▶ Exporting IP for phidist_pdf_best...$(NC)"
	@mkdir -p $(BUILD_HLS_DIR)/phidist_pdf_best/logs
	cd $(BUILD_HLS_DIR)/phidist_pdf_best && $(VITIS_HLS) -f ip_export.tcl 2>&1 | tee logs/ip_export.log
	@$(ECHO) "$(GREEN)✅ IP export complete - check $(BUILD_HLS_DIR)/phidist_pdf_best/logs/ip_export.log$(NC)"

$(BUILD_HLS_DIR)/phidist_pdf_best/solution1/syn/report/phidist_pdf_best_csynth.rpt:
	@$(ECHO) "$(YELLOW)⚠️  Synthesis report not found, running synthesis first...$(NC)"
	@$(MAKE) -f Makefile.hls hls_synth_phidist_pdf_best

hls_clean_phidist_pdf_best:
	@$(ECHO) "$(YELLOW)▶ Cleaning phidist_pdf_best HLS artifacts...$(NC)"
	rm -rf $(BUILD_HLS_DIR)/phidist_pdf_best
	@$(ECHO) "$(GREEN)✅ Cleaned$(NC)"

# -----------------------------------------------------------------------------
# Batch operations (deduped and fixed)
# -----------------------------------------------------------------------------

hls_csim_all: hls_csim_dt hls_csim_csc hls_csim_concentrator hls_csim_layermem hls_csim_region_filter hls_csim_priority_arbiter hls_csim_phi_extrapolation hls_csim_phi_dist_processor hls_csim_pdf_lookup hls_csim_best_candidate hls_csim_doublebuff
	@echo "$(GREEN)✅ All C simulations complete$(NC)"

hls_synth_all: hls_synth_dt hls_synth_csc hls_synth_concentrator hls_synth_layermem hls_synth_region_filter hls_synth_priority_arbiter hls_synth_phi_extrapolation hls_synth_phi_dist_processor hls_synth_pdf_lookup hls_synth_best_candidate hls_synth_doublebuff hls_synth_nn_interface hls_synth_regression_nn hls_synth_phidist_pdf_best
	@echo "$(GREEN)✅ All syntheses complete$(NC)"

hls_cosim_all: hls_cosim_dt hls_cosim_csc hls_cosim_concentrator hls_cosim_layermem hls_cosim_region_filter hls_cosim_priority_arbiter hls_cosim_phi_extrapolation hls_cosim_phi_dist_processor hls_cosim_pdf_lookup hls_cosim_best_candidate hls_cosim_doublebuff
	@echo "$(GREEN)✅ All co-simulations complete$(NC)"

hls_export_all: hls_export_dt hls_export_csc hls_export_concentrator hls_export_layermem hls_export_region_filter hls_export_priority_arbiter hls_export_phi_extrapolation hls_export_phi_dist_processor hls_export_pdf_lookup hls_export_best_candidate hls_export_doublebuff hls_export_nn_interface hls_export_regression_nn hls_export_phidist_pdf_best
	@echo "$(GREEN)✅ All IP exports complete$(NC)"

hls_clean:
	@echo "$(YELLOW)▶ Cleaning all HLS build artifacts...$(NC)"
	rm -rf $(BUILD_HLS_DIR)
	@echo "$(GREEN)✅ All HLS artifacts cleaned$(NC)"

# -----------------------------------------------------------------------------
# Parallel Operations
# -----------------------------------------------------------------------------

MODULES ?= all

hls_parallel_csim:
	@$(ECHO) "$(GREEN)▶ Running parallel C simulation ($(PARALLEL_JOBS) jobs)...$(NC)"
	@bash $(PARALLEL_SCRIPT) -j $(PARALLEL_JOBS) -c csim -m "$(MODULES)" -v $(VITIS_HLS)

hls_parallel_synth:
	@$(ECHO) "$(GREEN)▶ Running parallel synthesis ($(PARALLEL_JOBS) jobs)...$(NC)"
	@bash $(PARALLEL_SCRIPT) -j $(PARALLEL_JOBS) -c synth -m "$(MODULES)" -v $(VITIS_HLS)

hls_parallel_cosim:
	@$(ECHO) "$(GREEN)▶ Running parallel co-simulation ($(PARALLEL_JOBS) jobs)...$(NC)"
	@bash $(PARALLEL_SCRIPT) -j $(PARALLEL_JOBS) -c cosim -m "$(MODULES)" -v $(VITIS_HLS)

hls_parallel_export:
	@$(ECHO) "$(GREEN)▶ Running parallel IP export ($(PARALLEL_JOBS) jobs)...$(NC)"
	@bash $(PARALLEL_SCRIPT) -j $(PARALLEL_JOBS) -c export -m "$(MODULES)" -v $(VITIS_HLS)

# -----------------------------------------------------------------------------
# Log Analysis
# -----------------------------------------------------------------------------

hls_summary_%:
	@if [ -d "$(LOG_DIR)/$*" ]; then \
		echo "$(GREEN)▶ Parsing HLS logs for $*...$(NC)"; \
		$(PYTHON) $(TOOLS_DIR)/parse_hls_logs.py $(LOG_DIR)/$*; \
	else \
		echo "$(RED)❌ No logs found for $*. Run HLS flow first.$(NC)"; \
		exit 1; \
	fi

hls_logs_%:
	@if [ -d "$(LOG_DIR)/$*" ]; then \
		echo "$(GREEN)▶ Opening logs directory for $*...$(NC)"; \
		ls -lh $(LOG_DIR)/$*; \
	else \
		echo "$(RED)❌ No logs found for $*$(NC)"; \
		exit 1; \
	fi

# -----------------------------------------------------------------------------
# Testbench build deps
# -----------------------------------------------------------------------------

$(BUILD_DIR)/Makefile:
	@echo "$(YELLOW)⚠ Build directory not configured. Running CMake...$(NC)"
	@mkdir -p $(BUILD_DIR)
	cd $(BUILD_DIR) && cmake ..

$(BUILD_DIR)/tb_dt_interface: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_dt_interface

$(BUILD_DIR)/tb_csc_interface: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_csc_interface

$(BUILD_DIR)/tb_layermem: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_layermem

$(BUILD_DIR)/tb_region_filter: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_region_filter

$(BUILD_DIR)/tb_phi_extrapolation: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_phi_extrapolation

$(BUILD_DIR)/tb_phi_dist_processor: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_phi_dist_processor

$(BUILD_DIR)/tb_pdf_lookup: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_pdf_lookup

$(BUILD_DIR)/tb_best_candidate: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_best_candidate

$(BUILD_DIR)/tb_pdf_lookup_best_candidate: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_pdf_lookup

$(BUILD_DIR)/tb_concentrator: $(BUILD_DIR)/Makefile
	cd $(BUILD_DIR) && make tb_concentrator

# (add tb_doublebuff if there's a standalone testbench for doublebuff, same style)

.PHONY: hls_setup hls_setup_% \
        hls_csim_dt hls_synth_dt hls_cosim_dt hls_export_dt hls_all_dt hls_clean_dt \
