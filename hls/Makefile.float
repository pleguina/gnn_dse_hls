# Makefile for HLS Float Testbench
# Compiles the float version without Vitis HLS (standard C++)

CXX = g++
CXXFLAGS = -std=c++11 -Wall -O2 -DCSIM
INCLUDES = -I.

# Source files
SOURCES = graphsage_layer_float.cpp testbench_float.cpp
HEADERS = graphsage_layer_float.h
TARGET = testbench_float

# Test vectors directory
TEST_VECTORS_DIR = ../build/test_vectors

.PHONY: all clean run

all: $(TARGET)

$(TARGET): $(SOURCES) $(HEADERS)
	@echo "Compiling HLS float testbench..."
	$(CXX) $(CXXFLAGS) $(INCLUDES) $(SOURCES) -o $(TARGET)
	@echo "✓ Compilation successful!"

run: $(TARGET)
	@echo ""
	@echo "========================================"
	@echo "Running HLS Float Testbench"
	@echo "========================================"
	@echo ""
	@echo "Test vectors from: $(TEST_VECTORS_DIR)"
	@echo ""
	./$(TARGET)

clean:
	rm -f $(TARGET)
	@echo "Cleaned build artifacts"

help:
	@echo "HLS Float Testbench Makefile"
	@echo ""
	@echo "Usage:"
	@echo "  make             - Compile the testbench"
	@echo "  make run         - Compile and run the testbench"
	@echo "  make clean       - Remove compiled files"
	@echo "  make help        - Show this help message"
	@echo ""
	@echo "The testbench will use test vectors from:"
	@echo "  $(TEST_VECTORS_DIR)"
